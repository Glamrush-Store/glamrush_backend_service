APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=glamrush_admin_service
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Local SPA authentication. Replace wildcard domains with the storefront
# host in production and enable secure cookies under HTTPS.
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=*
CORS_ALLOWED_ORIGINS=*

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
REDIS_QUEUE=glamrush-storefront

# Domain event transport: laravel, rabbitmq, or kafka.
EVENT_BUS_DRIVER=laravel

RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_EVENT_EXCHANGE=glamrush.events
RABBITMQ_EVENT_QUEUE=glamrush-backend.events
RABBITMQ_ROUTING_KEY_PREFIX=glamrush
RABBITMQ_BINDING_KEY=glamrush.#
RABBITMQ_PREFETCH_COUNT=10
RABBITMQ_SSL=false

KAFKA_BROKERS=127.0.0.1:9092
KAFKA_EVENT_TOPIC=glamrush.events
KAFKA_CONSUMER_GROUP=glamrush-backend
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_SECURITY_PROTOCOL=
KAFKA_SASL_MECHANISMS=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_SSL_CA_LOCATION=

CACHE_STORE=redis
CACHE_LIMITER=redis
# CACHE_PREFIX=
CACHE_VERSION_CHECK_TTL_SECONDS=10

API_RATE_LIMIT_GENERAL_PER_MINUTE=120
API_RATE_LIMIT_CATALOG_PER_MINUTE=300
API_RATE_LIMIT_LOGIN_PER_MINUTE=5
API_RATE_LIMIT_ONBOARDING_PER_MINUTE=5
API_RATE_LIMIT_PASSWORD_FORGOT_EMAIL_PER_HOUR=3
API_RATE_LIMIT_PASSWORD_FORGOT_IP_PER_HOUR=10
API_RATE_LIMIT_PASSWORD_VERIFY_PER_REQUEST=5
API_RATE_LIMIT_PASSWORD_RESET_PER_HOUR=5
API_RATE_LIMIT_CART_MUTATIONS_PER_MINUTE=30
API_RATE_LIMIT_CHECKOUT_PAYMENT_PER_MINUTE=10
API_RATE_LIMIT_PAYMENT_VERIFY_PER_MINUTE=10
API_RATE_LIMIT_WEBHOOK_IP_PER_MINUTE=120
API_RATE_LIMIT_WEBHOOK_PROVIDER_PER_MINUTE=600
API_RATE_LIMIT_NEWSLETTER_EMAIL_PER_HOUR=3
API_RATE_LIMIT_NEWSLETTER_IP_PER_HOUR=10
API_RATE_LIMIT_NEWSLETTER_ACTION_PER_MINUTE=10

NEWSLETTER_CONFIRMATION_TTL_MINUTES=1440

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=resend
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
RESEND_API_KEY=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_ADMIN_ADDRESS=
CONTACT_NOTIFICATION_ADDRESS=
API_RATE_LIMIT_CONTACT_SUBMISSIONS_PER_MINUTE=5
MAIL_ADMIN_NAME="${APP_NAME} Admin"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Fully hydrated storefront homepages are refreshed after this many seconds.
STOREFRONT_HOMEPAGE_CACHE_TTL=300
STOREFRONT_CONTEXT_CACHE_TTL=300
PAYMENT_METHODS_CACHE_TTL=600
SHIPPING_CACHE_TTL=300
PUBLIC_HTTP_CACHE_MAX_AGE=60
PUBLIC_HTTP_CACHE_SHARED_MAX_AGE=60
PUBLIC_HTTP_CACHE_STALE_WHILE_REVALIDATE=15
IDEMPOTENCY_LOCK_SECONDS=60
IDEMPOTENCY_WAIT_SECONDS=10
STOREFRONT_HOMEPAGE_MAX_ITEMS=50

PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=http://127.0.0.1:3000/payment/callback?provider=paystack

FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=
FLUTTERWAVE_CALLBACK_URL=http://127.0.0.1:3000/payment/callback?provider=flutterwave
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3
