            "Categories": {
                "properties": {
                    "id": {
                        "type": "string",
                        "example": "01J2P9WQZ3YJ6R8X9A2C4D5E6F"
                    },
                    "name": {
                        "type": "string",
                        "example": "Skin Care"
                    },
