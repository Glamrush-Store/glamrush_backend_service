                        "type": "boolean",
                        "example": true
                    },
                    "stockQuantity": {
                        "type": "integer",
                        "example": 10
                    },
                    "inStock": {
                        "type": "boolean",
                        "example": true
                    },
                    "attributes": {
                        "type": "array",
