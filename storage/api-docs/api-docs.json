{
    "openapi": "3.0.0",
    "info": {
        "title": "Catalog API",
        "description": "Public catalog endpoints",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "https://api.example.com",
            "description": "Production"
        }
    ],
    "paths": {
        "/api/v1/storefronts/{storefront}/pages/{slug}": {
            "get": {
                "tags": [
                    "Public Content"
                ],
                "summary": "Get a published storefront page",
                "operationId": "674d830941507f1b68f3dc2fb16be80e",
                "parameters": [
                    {
                        "name": "storefront",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "example": "fragrances"
                        }
                    },
                    {
                        "name": "slug",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "example": "about"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Published page"
                    },
                    "404": {
                        "description": "Storefront or page unavailable"
                    }
                }
            }
        },
        "/api/v1/storefronts/{storefront}/faqs": {
            "get": {
                "tags": [
                    "Public Content"
                ],
                "summary": "List published storefront FAQs",
                "operationId": "1d58a84a2ece61f6b26629d6c428c284",
                "parameters": [
                    {
                        "name": "storefront",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "example": "fragrances"
                        }
                    },
                    {
                        "name": "category",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "search",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "minimum": 1
                        }
                    },
                    {
                        "name": "per_page",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "maximum": 50,
                            "minimum": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Grouped FAQ results"
                    },
                    "404": {
                        "description": "Storefront unavailable"
                    },
                    "422": {
                        "description": "Invalid filter"
                    }
                }
            }
        },
        "/api/v1/storefronts/{storefront}/contact-submissions": {
            "post": {
                "tags": [
                    "Contact"
                ],
                "summary": "Submit a public contact message",
                "operationId": "2559c00f8be76b102e8e9f661a10496a",
                "parameters": [
                    {
                        "name": "storefront",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "example": "fragrances"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "email",
                                    "message"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "maxLength": 150
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email"
                                    },
                                    "phone": {
                                        "type": "string",
                                        "nullable": true
                                    },
                                    "subject": {
                                        "type": "string",
                                        "nullable": true
                                    },
                                    "message": {
                                        "type": "string",
                                        "maxLength": 5000,
                                        "minLength": 10
                                    },
                                    "source": {
                                        "type": "string",
                                        "example": "contact-page",
                                        "nullable": true
                                    },
                                    "website": {
                                        "description": "Honeypot; leave empty",
                                        "type": "string"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "202": {
                        "description": "Message accepted; response contains only a reference"
                    },
                    "404": {
                        "description": "Storefront unavailable"
                    },
                    "422": {
                        "description": "Invalid message"
                    },
                    "429": {
                        "description": "Rate limit exceeded"
                    }
                }
            }
        },
        "/api/v1/storefronts/{storefront}/homepage": {
            "get": {
                "tags": [
                    "Storefront"
                ],
                "summary": "Get the fully hydrated public storefront homepage",
                "operationId": "getStorefrontHomepage",
                "parameters": [
                    {
                        "name": "storefront",
                        "in": "path",
                        "description": "Active root-category storefront slug",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "example": "fragrances"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Published homepage content. Campaign is nullable and sections may be empty.",
                        "content": {
                            "application/json": {
                                "schema": {},
                                "example": {
                                    "success": true,
                                    "message": "Success",
                                    "data": {
                                        "storefront": {
                                            "slug": "fragrances",
                                            "name": "Fragrances",
                                            "announcement": {
                                                "primary_text": "Free Lagos delivery on orders over ₦100,000",
                                                "secondary_text": "Complimentary scent consultation"
                                            }
                                        },
                                        "campaign": {
                                            "id": "01K1ABCDEF1234567890ABCDEF",
                                            "eyebrow": "After-dark fragrances",
                                            "title": "Leave a trace.",
                                            "description": "A magnetic collection for after dark.",
                                            "desktop_image": "https://cdn.example.com/campaign-desktop.webp",
                                            "mobile_image": "https://cdn.example.com/campaign-mobile.webp",
                                            "cta_label": "Shop the campaign",
                                            "cta_url": "/collections/midnight-edit",
                                            "starts_at": "2026-08-01T00:00:00.000000Z",
                                            "ends_at": null
                                        },
                                        "sections": [
                                            {
                                                "id": "01K1ABCDEF1234567890ABCDEG",
                                                "type": "featured_products",
                                                "title": "Currently coveted",
                                                "subtitle": null,
                                                "display_order": 1,
                                                "items": []
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Unknown, inactive, or non-root storefront"
                    }
                }
            }
        },
        "/api/v1/storefronts/{storefront}/configuration": {
            "get": {
                "tags": [
                    "Storefront"
                ],
                "summary": "Get public storefront-wide presentation settings",
                "operationId": "getStorefrontConfiguration",
                "parameters": [
                    {
                        "name": "storefront",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "example": "fragrances"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Public storefront presentation settings.",
                        "content": {
                            "application/json": {
                                "schema": {},
                                "example": {
                                    "success": true,
                                    "message": "Success",
                                    "data": {
                                        "announcement": {
                                            "primary_text": "Free Lagos delivery on orders over ₦100,000",
                                            "secondary_text": "Complimentary scent consultation"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Unknown or inactive storefront."
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "Brands": {
                "properties": {
                    "id": {
                        "type": "string",
                        "example": "01J2P9WQZ3YJ6R8X9A2C4D5E6F"
                    },
                    "name": {
                        "type": "string",
                        "example": "St Ive's"
                    },
                    "slug": {
                        "type": "string",
                        "example": "st-ives"
                    },
                    "description": {
                        "type": "string",
                        "example": "A long lipsium ipsium description",
                        "nullable": true
                    },
                    "metaTitle": {
                        "type": "string",
                        "example": "A long lipsium ipsium description",
                        "nullable": true
                    },
                    "metaDescription": {
                        "type": "string",
                        "example": "A long lipsium ipsium description",
                        "nullable": true
                    },
                    "sortOrder": {
                        "type": "integer",
                        "example": 4,
                        "nullable": true
                    },
                    "isActive": {
                        "type": "boolean",
                        "example": true
                    }
                },
                "type": "object"
            },
            "Categories": {
                "properties": {
                    "id": {
                        "type": "string",
                        "example": "01J2P9WQZ3YJ6R8X9A2C4D5E6F"
                    },
                    "name": {
                        "type": "string",
                        "example": "Skin Care"
                    },
                    "parent": {
                        "$ref": "#/components/schemas/parentCategory"
                    },
                    "slug": {
                        "type": "string",
                        "example": "skin-care"
                    },
                    "description": {
                        "type": "string",
                        "example": "A long lipsium ipsium description",
                        "nullable": true
                    },
                    "metaTitle": {
                        "type": "string",
                        "example": "A long lipsium ipsium description",
                        "nullable": true
                    },
                    "metaDescription": {
                        "type": "string",
                        "example": "A long lipsium ipsium description",
                        "nullable": true
                    },
                    "sortOrder": {
                        "type": "integer",
                        "example": 4,
                        "nullable": true
                    },
                    "isActive": {
                        "type": "boolean",
                        "example": true
                    }
                },
                "type": "object"
            },
            "parentCategory": {
                "properties": {
                    "id": {
                        "type": "string",
                        "example": "01J2P9WQZ3YJ6R8X9A2C4D5E6F",
                        "nullable": true
                    },
                    "name": {
                        "type": "string",
                        "example": "Skin Care",
                        "nullable": true
                    },
                    "slug": {
                        "type": "string",
                        "example": "skin-care",
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "vendors": {
                "properties": {
                    "id": {
                        "type": "string",
                        "example": "01J2P9WQZ3YJ6R8X9A2C4D5E6F"
                    },
                    "name": {
                        "type": "string",
                        "example": "Skin Care"
                    },
                    "business_name": {
                        "type": "string",
                        "example": "Glow Enterprise"
                    }
                },
                "type": "object"
            },
            "PaginationMeta": {
                "properties": {
                    "currentPage": {
                        "type": "integer",
                        "example": 1
                    },
                    "perPage": {
                        "type": "integer",
                        "example": 20
                    },
                    "total": {
                        "type": "integer",
                        "example": 120
                    }
                },
                "type": "object"
            },
            "Price": {
                "properties": {
                    "amount": {
                        "type": "integer",
                        "example": 1000
                    },
                    "currency": {
                        "type": "string",
                        "example": "NGN"
                    },
                    "saleAmount": {
                        "type": "integer",
                        "example": "800",
                        "nullable": true
                    },
                    "onSale": {
                        "type": "boolean",
                        "example": "true"
                    }
                },
                "type": "object"
            }
        }
    },
    "tags": [
        {
            "name": "Public Content",
            "description": "Public Content"
        },
        {
            "name": "Contact",
            "description": "Contact"
        },
        {
            "name": "Storefront",
            "description": "Storefront"
        }
    ]
}