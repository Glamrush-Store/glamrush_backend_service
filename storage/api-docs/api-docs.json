                    },
                    "metaTitle": {
                        "type": "string",
                        "example": "A long lipsium ipsium description",
                        "nullable": true
                    },
                    "metaDescription": {
                        "type": "string",
                        "example": "A long lipsium ipsium description",
                        "nullable": true
                    },
                    "sortOrder": {
                        "type": "integer",
                        "example": 4,
                        "nullable": true
                    },
                    "isActive": {
                        "type": "boolean",
                        "example": true
                    }
                },
                "type": "object"
