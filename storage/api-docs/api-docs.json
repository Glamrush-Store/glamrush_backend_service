                    "isDefault": {
                        "type": "boolean",
                        "example": "false"
                    },
                    "price": {
                        "$ref": "#/components/schemas/Price"
                    },
                    "salePrice": {
                        "$ref": "#/components/schemas/Price"
                    },
                    "saleStartsAt": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2025-01-01T00:00:00.000000Z"
                    },
                    "saleEndsAt": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2025-03-01T00:00:00.000000Z"
