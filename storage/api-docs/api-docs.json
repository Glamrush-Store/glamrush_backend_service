                        "type": "string",
                        "example": "Facial scrub lemon fragrance ",
                        "nullable": true
                    },
                    "description": {
                        "type": "string",
                        "example": "Facial scrub lemon fragrance with very much more additional info",
                        "nullable": true
                    },
                    "type": {
