                            "type": "mixed"
                        },
                        "example": "[{'color': 'red', 'size': 'large'}]"
                    },
                    "sortOrder": {
                        "type": "integer",
                        "example": 1
                    },
                    "status": {
                        "type": "string",
                        "example": "active"
                    }
                },
                "type": "object"
            },
            "PaginationMeta": {
                "properties": {
                    "currentPage": {
                        "type": "integer",
                        "example": 1
                    },
                    "perPage": {
                        "type": "integer",
                        "example": 20
                    },
                    "total": {
                        "type": "integer",
                        "example": 120
                    }
                },
                "type": "object"
            },
            "Price": {
                "properties": {
                    "amount": {
                        "type": "integer",
